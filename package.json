{
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.12.0",
    "postprocessing": "^6.39.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "playwright": "^1.62.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^3.2.4"
  },
  "name": "blackops-frontline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:assets": "node scripts/verify-nightglass-assets.mjs",
    "qa:capture": "node scripts/capture-screens.mjs",
    "qa:capture:matrix": "CAPTURE_MATRIX=1 CAPTURE_RELEASE=1 node scripts/capture-screens.mjs",
    "qa:capture:matrix:dev": "CAPTURE_MATRIX=1 SCREENSHOT_DIR=artifacts/screenshots-dev node scripts/capture-screens.mjs",
    "qa:visual:prepare": "node scripts/prepare-visual-inspection.mjs",
    "qa:capture:verify": "node scripts/verify-capture-matrix.mjs",
    "qa:performance:capture": "node scripts/capture-performance.mjs",
    "qa:performance": "node scripts/verify-performance.mjs",
    "qa:review:prepare": "node scripts/prepare-blind-review.mjs",
    "qa:review:score": "node scripts/score-blind-review.mjs",
    "qa:release": "node scripts/verify-release-readiness.mjs"
  }
}
