        "compressed": "ktx2-etc1s",
        "textureSemantic": "lightmap"
      },
      "license": { "name": "REPLACE_WITH_DISTRIBUTION_LICENSE" }
    },
    {
      "id": "weapon-ar-fire",
      "kind": "audio",
      "url": "audio/weapon-ar-fire.ogg",
      "bytes": 1,
      "required": true,
      "metadata": {
        "sourceGroup": "audio",
        "sourceRecord": "REPLACE_WITH_AUDIO_SOURCE_RECORD",
        "licenseRecord": "REPLACE_WITH_AUDIO_LICENSE_RECORD",
        "compressed": "audio",
        "capabilities": ["weapon-layers"]
      },
      "license": { "name": "REPLACE_WITH_DISTRIBUTION_LICENSE" }
    },
    {
      "id": "reference-01",
      "kind": "image",
      "url": "references/reference-01.png",
      "metadata": {
        "sourceGroup": "references",
        "sourceRecord": "REPLACE_WITH_REFERENCE_SOURCE_RECORD",
